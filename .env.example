# EOD Historical Data (EODHD) API token
# https://eodhd.com/financial-apis/api-for-historical-data-and-volumes
EODHD_API_KEY=

# Managed TemporalDB deployment: mandatory durable capture before fresh publish.
# Required mode refuses provider startup if the bridge/policy is incomplete.
EODHD_CAPTURE_REQUIRED=0
EODHD_CAPTURE_URL=https://temporaldb.example.invalid
EODHD_CAPTURE_TOKEN=
EODHD_CAPTURE_WORKSPACE_ID=
EODHD_CAPTURE_ENTITLEMENT=
EODHD_CAPTURE_PRINCIPAL=
# Explicit private-network trust only; default permits HTTPS or loopback HTTP.
EODHD_CAPTURE_TRUST_INTERNAL_HTTP=0
